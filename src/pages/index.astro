---
const pageTitle = 'Wang Lab';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Website for Wang Lab" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">Website coming soon</p>
      <h1>{pageTitle}</h1>
      <p>Superconducting quantum circuits and quantum information research.</p>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    min-height: 100vh;
    margin: 0;
    display: grid;
    place-items: center;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #1f2933;
    background: #f7f8f5;
  }

  main {
    width: min(100% - 2rem, 42rem);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: #667085;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 12vw, 7rem);
    line-height: 0.95;
    letter-spacing: 0;
  }

  h1 + p {
    max-width: 34rem;
    margin: 1.25rem 0 0;
    color: #475467;
    font-size: 1.15rem;
    line-height: 1.6;
  }
</style>
