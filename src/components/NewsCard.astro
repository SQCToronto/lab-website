---
import { withBase } from '../lib/paths.mjs';

interface Props {
  entry: {
    data: {
      title: string;
      date: Date;
      category: string;
      summary: string;
      image?: string;
      imageAlt?: string;
      externalUrl?: string;
    };
  };
  featured?: boolean;
}

const { entry, featured = false } = Astro.props;
const { title, date, category, summary, image, imageAlt, externalUrl } = entry.data;
const dateLabel = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<article class:list={['news-card', { featured }]}>
  {image && <img src={withBase(image)} alt={imageAlt ?? ''} loading="lazy" />}
  <div class="news-card-body">
    <div class="news-card-meta"><span>{category}</span><time datetime={date.toISOString()}>{dateLabel}</time></div>
    <h3>{title}</h3>
    <p>{summary}</p>
    {externalUrl && <a class="text-link" href={externalUrl}>Read the paper <span aria-hidden="true">↗</span></a>}
  </div>
</article>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    border-top: 2px solid var(--teal);
    background: var(--white);
  }

  .news-card > img {
    width: 100%;
    aspect-ratio: 16 / 8;
    display: block;
    object-fit: cover;
    background: var(--surface-alt);
  }

  .news-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.4rem 1.35rem 1.5rem;
  }

  .news-card-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--coral);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .news-card h3 {
    margin: 1rem 0 0.75rem;
    font-size: 1.25rem;
    line-height: 1.15;
  }

  .news-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .text-link {
    margin-top: auto;
    padding-top: 1.25rem;
    color: var(--teal-dark);
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
  }

  .text-link span {
    color: var(--coral);
  }
</style>
