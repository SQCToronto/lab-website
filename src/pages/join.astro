---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { withBase } from '../lib/paths.mjs';
---

<BaseLayout title="Join" description="Opportunities to join the Superconducting Qubit Toronto Lab at the University of Toronto.">
  <PageIntro
    eyebrow="Join the lab"
    title="Build the next generation of quantum systems."
    description="SQT Lab is launching at the University of Toronto in 2026. We welcome researchers drawn to careful experiments, open-system dynamics, and practical quantum error correction."
  />

  <section class="join-section">
    <div class="join-intro">
      <p class="section-marker">Opportunities</p>
      <h2>Different backgrounds, shared curiosity.</h2>
    </div>
    <div class="opportunity-grid">
      <article class="opportunity">
        <p class="opportunity-number">01</p>
        <h3>Postdoctoral researchers</h3>
        <p>We are interested in postdoctoral researchers with experience in superconducting circuits, quantum information, microwave engineering, cryogenic measurement, or related areas.</p>
        <a class="text-link" href="mailto:chen.wang@utoronto.ca">Contact Chen Wang <span aria-hidden="true">↗</span></a>
      </article>
      <article class="opportunity">
        <p class="opportunity-number">02</p>
        <h3>Graduate students</h3>
        <p>Graduate researchers can contribute to experiments spanning bosonic encodings, decoherence spectroscopy, efficient error-correction architectures, and engineered dissipation.</p>
        <a class="text-link" href="https://www.sgs.utoronto.ca/programs/physics/">Graduate Physics at U of T <span aria-hidden="true">↗</span></a>
      </article>
      <article class="opportunity">
        <p class="opportunity-number">03</p>
        <h3>Undergraduate researchers</h3>
        <p>Undergraduates interested in experimental physics, quantum information, and hands-on lab work are encouraged to learn about research opportunities through the Department of Physics.</p>
        <a class="text-link" href="https://www.physics.utoronto.ca/">Department of Physics <span aria-hidden="true">↗</span></a>
      </article>
    </div>
  </section>

  <section class="toronto-join">
    <div class="toronto-join-inner">
      <div>
        <p class="section-marker">Toronto</p>
        <h2>Find your place in the quantum community.</h2>
      </div>
      <div>
        <p>Our work connects with the broader University of Toronto quantum ecosystem, including the Centre for Quantum Information and Quantum Control.</p>
        <div class="join-links">
          <a href="https://cqiqc.physics.utoronto.ca/">CQIQC <span aria-hidden="true">↗</span></a>
          <a href={withBase('/people/')}>Meet the current group <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-section">
    <p class="section-marker">Start a conversation</p>
    <h2>Chen Wang</h2>
    <p>Department of Physics, University of Toronto · MP1023B</p>
    <a class="button button-dark" href="mailto:chen.wang@utoronto.ca">chen.wang@utoronto.ca <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>

<style>
  .join-section,
  .contact-section {
    max-width: var(--content);
    margin: 0 auto;
    padding-right: clamp(1.25rem, 4vw, 4rem);
    padding-left: clamp(1.25rem, 4vw, 4rem);
  }

  .join-section {
    padding-top: 1rem;
    padding-bottom: 6rem;
  }

  .join-intro {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .join-intro h2,
  .toronto-join h2,
  .contact-section h2 {
    max-width: 38rem;
    margin: 0;
    font-family: var(--serif);
    font-size: 3.1rem;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .opportunity-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .opportunity {
    min-height: 20rem;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-top: 2px solid var(--teal);
    background: var(--white);
  }

  .opportunity-number {
    margin: 0;
    color: var(--coral);
    font-family: var(--serif);
    font-size: 1.4rem;
  }

  .opportunity h3 {
    margin: 2rem 0 0.8rem;
    font-size: 1.3rem;
    line-height: 1.15;
  }

  .opportunity > p:not(.opportunity-number) {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .opportunity .text-link {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .text-link,
  .join-links a {
    color: var(--teal-dark);
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
  }

  .text-link span,
  .join-links span {
    color: var(--coral);
  }

  .toronto-join {
    color: var(--white);
    background: var(--graphite-soft);
  }

  .toronto-join-inner {
    max-width: var(--content);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    padding: 5.5rem clamp(1.25rem, 4vw, 4rem);
  }

  .toronto-join h2 {
    font-size: 3.2rem;
  }

  .toronto-join p:not(.section-marker) {
    max-width: 28rem;
    margin: 0;
    color: #b9c9c3;
    line-height: 1.7;
  }

  .join-links {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .join-links a {
    padding: 0.75rem 0;
    border-top: 1px solid var(--line-dark);
    color: var(--white);
  }

  .contact-section {
    padding-top: 5rem;
    padding-bottom: 6rem;
  }

  .contact-section h2 {
    margin-top: 1rem;
  }

  .contact-section p:not(.section-marker) {
    margin: 0.9rem 0 1.75rem;
    color: var(--muted);
  }

  .button-dark {
    color: var(--white);
    background: var(--graphite);
  }

  @media (max-width: 800px) {
    .opportunity-grid {
      grid-template-columns: 1fr;
    }

    .opportunity {
      min-height: auto;
    }
  }

  @media (max-width: 700px) {
    .join-intro,
    .toronto-join-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .join-intro h2,
    .toronto-join h2,
    .contact-section h2 {
      font-size: 2.45rem;
    }
  }
</style>
