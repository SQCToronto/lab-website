---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import PersonEntry from '../components/PersonEntry.astro';
import { people } from '../data/people.mjs';
import { withBase } from '../lib/paths.mjs';

const principalInvestigator = people.find((person) => person.group === 'principal-investigator');
const currentPeople = people.filter((person) => person.group !== 'alumni' && person.group !== 'principal-investigator');
const currentGroups = [
  {
    label: 'Postdoctoral associates and research scientist',
    members: [
      ...currentPeople.filter((person) => person.group === 'research-scientist'),
      ...currentPeople.filter((person) => person.group === 'postdoctoral'),
    ],
  },
  { label: 'Graduate students', members: currentPeople.filter((person) => person.group === 'graduate') },
  { label: 'Undergraduate students', members: currentPeople.filter((person) => person.group === 'undergraduate') },
];
const alumni = people.filter((person) => person.group === 'alumni');
const alumniGroups = [
  { label: 'Former graduate students', members: alumni.filter((person) => person.role === 'Graduate student') },
  { label: 'Former postdoctoral associates', members: alumni.filter((person) => person.role === 'Postdoctoral associate') },
  { label: 'Former undergraduate students', members: alumni.filter((person) => person.role === 'Undergraduate student') },
];
const groupHistory = [
  { year: '2026', image: '/images/group/Group-photo-2026b.jpg', caption: 'Group mini-golf outing, 2026.' },
  { year: '2026', image: '/images/group/Group-photo-2026.jpg', caption: 'Group photo outside the lab building, 2026.' },
  { year: '2025', image: '/images/group/APS-Physics-escape-game-2025.jpg', caption: 'LabEscape at APS Physics, 2025.' },
  { year: '2024', image: '/images/group/Hiking-Sugarloaf-2024.jpg', caption: 'Group hike at Sugarloaf Mountain, 2024.' },
  { year: '2023', image: '/images/group/Quantum-chess-at-Chen-house-2023.jpg', caption: "Quantum chess at Chen's house, 2023." },
  { year: '2023', image: '/images/group/Group-photo-2023b.jpg', caption: 'Group escape game, 2023.' },
  { year: '2023', image: '/images/group/group-photo-2023.jpg', caption: 'Group photo in the lab, 2023.' },
  { year: '2021', image: '/images/group/Group-photo-2021.jpg', caption: 'Group photo outside the lab, 2021.' },
  { year: '2019', image: '/images/group/Group-photo-2019.jpg', caption: 'Group photo outside the lab, 2019.' },
  { year: '2017', image: '/images/group/Group-photo-2017.jpg', caption: 'Group photo in the lab, 2017.' },
];
---

<BaseLayout title="People" description="Current members and alumni of the Superconducting Qubit Toronto Lab.">
  <PageIntro
    eyebrow="People"
    title="The people behind the experiments."
    description="The lab's current team carries forward the UMass Amherst chapter as we build a new research community in Toronto."
  />

  <section class="people-section lead-section">
    <div class="lead-copy">
      <p class="section-marker">Principal investigator</p>
      <PersonEntry person={principalInvestigator} featured />
    </div>
  </section>

  <section class="people-section current-section">
    <p class="section-marker">Current members</p>
    {currentGroups.map((section) => {
      const members = section.members;
      return members.length > 0 && (
        <div class="people-group">
          <h2>{section.label}</h2>
          <div class="people-grid">{members.map((person) => <PersonEntry person={person} />)}</div>
        </div>
      );
    })}
  </section>

  <section class="alumni-section">
    <div class="people-section">
      <div class="section-heading">
        <p class="section-marker">Alumni</p>
        <h2>A growing scientific family.</h2>
      </div>
      {alumniGroups.map((section) => section.members.length > 0 && (
        <div class="alumni-group">
          <h3>{section.label}</h3>
          <div class="alumni-grid">{section.members.map((person) => <PersonEntry person={person} portrait={false} />)}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="group-history">
    <div class="people-section group-history-inner">
      <div class="group-history-heading">
        <p class="section-marker">Group history</p>
        <h2>From our first chapter to the next.</h2>
        <p>These photographs document the people and shared work that brought the lab to Toronto.</p>
      </div>
      <div class="history-gallery">
        {groupHistory.map((photo) => (
          <figure>
            <img src={withBase(photo.image)} alt={photo.caption} loading="lazy" />
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .people-section {
    max-width: var(--content);
    margin: 0 auto;
    padding-right: clamp(1.25rem, 4vw, 4rem);
    padding-left: clamp(1.25rem, 4vw, 4rem);
  }

  .lead-section {
    padding-bottom: 5rem;
  }

  .lead-copy {
    max-width: 62rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .lead-copy .person-entry {
    margin-top: 2rem;
  }

  .current-section {
    padding-top: 5rem;
    padding-bottom: 6rem;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: 3rem;
  }

  .section-heading .section-marker {
    margin-top: 0.5rem;
  }

  .section-heading h2,
  .group-history h2 {
    max-width: 38rem;
    margin: 0;
    font-family: var(--serif);
    font-size: 3.1rem;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .people-group {
    margin-top: 3.5rem;
  }

  .people-group > h2 {
    margin: 0 0 0.75rem;
    color: var(--teal-dark);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .people-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 4rem;
  }

  .alumni-section {
    background: var(--surface-alt);
  }

  .alumni-section .people-section {
    padding-top: 5.5rem;
    padding-bottom: 6rem;
  }

  .alumni-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 4rem;
  }

  .alumni-group {
    margin-top: 3rem;
  }

  .alumni-group h3 {
    margin: 0 0 0.75rem;
    color: var(--teal-dark);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .group-history {
    color: var(--white);
    background: var(--graphite-soft);
  }

  .group-history-inner {
    padding-top: 6rem;
    padding-bottom: 6rem;
  }

  .group-history-heading {
    max-width: 42rem;
  }

  .group-history p:not(.section-marker) {
    max-width: 26rem;
    margin: 1.5rem 0 0;
    color: #afbfba;
    line-height: 1.7;
  }

  .history-gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .history-gallery figure {
    margin: 0;
  }

  .history-gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: block;
    border: 1px solid var(--line-dark);
    object-fit: cover;
  }

  .history-gallery figcaption {
    margin-top: 0.75rem;
    color: #afbfba;
    font-size: 0.75rem;
  }

  @media (max-width: 700px) {
    .section-heading,
    .group-history-inner {
      grid-template-columns: 1fr;
    }

    .section-heading h2,
    .group-history h2 {
      font-size: 2.45rem;
    }

    .people-grid,
    .alumni-grid {
      grid-template-columns: 1fr;
    }

    .history-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
